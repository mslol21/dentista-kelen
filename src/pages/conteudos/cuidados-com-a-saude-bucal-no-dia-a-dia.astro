---
import Layout from '../../layouts/Layout.astro';
import { clinicConfig } from '../../config/clinic.config';

const article = clinicConfig.educationalArticles.find((a) => a.slug === 'cuidados-com-a-saude-bucal-no-dia-a-dia')!;

const breadcrumbs = [
  { name: 'Conteúdos Educativos', url: '/conteudos' },
  { name: article.title, url: `/conteudos/${article.slug}` },
];
---

<Layout
  title={`${article.title} | Dra. Kelen Odontologia`}
  description={article.summary}
  canonicalPath={`/conteudos/${article.slug}`}
  breadcrumbs={breadcrumbs}
  ogType="article"
  articleData={{
    headline: article.title,
    datePublished: article.publishDate,
    dateModified: article.reviewDate,
    author: article.author,
  }}
>
  <article class="container section">
    <div class="article-header-wrapper">
      <span class="badge">Higiene & Prevenção</span>
      <h1>{article.title}</h1>
      
      <div class="article-meta-card">
        <div class="meta-item">
          <strong>Revisão Clínica:</strong> {article.author} ({article.cro})
        </div>
        <div class="meta-item">
          <strong>Publicado em:</strong> {new Date(article.publishDate).toLocaleDateString('pt-BR')} | 
          <strong>Revisado em:</strong> {new Date(article.reviewDate).toLocaleDateString('pt-BR')}
        </div>
      </div>
    </div>

    <div class="article-body-grid">
      <div class="article-content-body">
        <p class="article-intro-lead">
          {article.summary}
        </p>

        {article.contentSections.map((sec) => (
          <section class="art-section">
            <h2>{sec.heading}</h2>
            {sec.body && <p>{sec.body}</p>}
            {sec.list && (
              <ul class="art-bullet-list">
                {sec.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}

        <div class="scientific-references card">
          <h3>Fontes e Referências Clínicas Consultadas</h3>
          <ul>
            <li>Sociedade Brasileira de Periodontologia (SOBRAPE).</li>
            <li>Associação Brasileira de Odontologia (ABO).</li>
            <li>World Health Organization (WHO) - Global Oral Health Action Plan.</li>
          </ul>
        </div>
      </div>

      <aside class="article-aside">
        <div class="card booking-sidebar-card">
          <h3>Check-up Preventivo em Guaianases</h3>
          <p>
            Mesmo com boa escovação, a profilaxia semestral no consultório remove tártaros que a escova não alcança.
          </p>
          <a href={clinicConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" style="width: 100%;">
            Falar pelo WhatsApp
          </a>
          <a href="/contato" class="btn btn-secondary" style="width: 100%; margin-top: 0.75rem;">
            Ver Telefone e Endereço
          </a>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h4>Outros Artigos</h4>
          <ul class="aside-other-articles">
            {clinicConfig.educationalArticles.filter((a) => a.slug !== article.slug).map((oa) => (
              <li>
                <a href={`/conteudos/${oa.slug}`}>{oa.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .article-header-wrapper {
    max-width: 860px;
    margin-bottom: 2.5rem;
  }

  .article-meta-card {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    background-color: var(--color-bg-body);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    margin-top: 1.25rem;
    color: var(--color-text-muted);
  }

  .article-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .article-body-grid {
      grid-template-columns: 1.35fr 0.65fr;
    }
  }

  .article-intro-lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-primary-dark);
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .art-section {
    margin-bottom: 2.5rem;
  }

  .art-section h2 {
    font-size: 1.4rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.85rem;
  }

  .art-section p {
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .art-bullet-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .art-bullet-list li {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .scientific-references {
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    margin-top: 3rem;
    padding: 1.5rem;
  }

  .scientific-references h3 {
    font-size: 1.05rem;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .scientific-references ul {
    padding-left: 1.25rem;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .booking-sidebar-card {
    background-color: var(--color-primary-light);
    border-color: rgba(13, 148, 136, 0.3);
  }

  .booking-sidebar-card h3 {
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .aside-other-articles {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .aside-other-articles a {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .aside-other-articles a:hover {
    text-decoration: underline;
  }
</style>
