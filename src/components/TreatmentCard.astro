---
import type { TreatmentInfo } from '../config/clinic.config';
interface Props { treatment: TreatmentInfo }
const { treatment } = Astro.props;
const descriptions: Record<string,string> = {
 'clinica-geral':'Prevenção, limpeza e restaurações para cuidar da saúde dos seus dentes e gengivas.',
 'odontologia-estetica':'Clareamento e restaurações estéticas com planejamento individualizado.',
 'ortodontia':'Avaliação do alinhamento dos dentes e da mordida, com acompanhamento em cada etapa.',
 'cirurgia-odontologica':'Extrações e procedimentos bucais com orientação antes e depois do atendimento.'
};
const names: Record<string,string> = {'clinica-geral':'Clínica geral','odontologia-estetica':'Estética dental','ortodontia':'Ortodontia','cirurgia-odontologica':'Cirurgia bucal'};
---
<article class="treatment-card"><div class="treatment-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M10 5c-5 0-6 6-4 12 1 3 2 9 4 10 3 1 2-9 6-9s3 10 6 9c2-1 3-7 4-10 2-6 1-12-4-12-3 0-4 2-6 2s-3-2-6-2Z"/><path d="M12 7c1 2 3 3 6 3"/>{treatment.slug==='odontologia-estetica'&&<path d="M27 2v6M24 5h6"/>}{treatment.slug==='ortodontia'&&<path d="M7 14h18M11 12v4M16 12v4M21 12v4"/>}</svg></div><h3><a href={`/tratamentos/${treatment.slug}`}>{names[treatment.slug] || treatment.name}</a></h3><p>{descriptions[treatment.slug] || treatment.shortDescription}</p><a class="treatment-more" href={`/tratamentos/${treatment.slug}`} aria-label={`Conhecer ${treatment.name}`}>Conhecer tratamento <span aria-hidden="true">↗</span></a></article>
<style>
.treatment-card{background:#f5f6ee;border:1px solid #e0e5d8;border-radius:12px;padding:27px 24px;display:flex;flex-direction:column;transition:background .2s,transform .2s,border-color .2s}.treatment-card:hover{background:#edf1e3;border-color:#b5c4a6;transform:translateY(-4px)}.treatment-icon{width:48px;height:48px;background:#e6ecd9;border-radius:50%;display:grid;place-items:center;color:#456b45;margin-bottom:26px}.treatment-card h3{font-family:Georgia,serif;font-size:25px;font-weight:400;letter-spacing:-.025em;margin-bottom:13px}.treatment-card h3 a{text-decoration:none;color:#2b5038}.treatment-card p{font-size:12px;line-height:1.85;color:#64715f;margin-bottom:25px;flex:1}.treatment-more{font-size:11px;font-weight:600;text-decoration:none;color:#345f40;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #d9e1cf;padding-top:16px;gap:10px}.treatment-more span{font-size:20px}@media(max-width:639px){.treatment-card{padding:24px}.treatment-icon{margin-bottom:18px}.treatment-card p{font-size:13px}.treatment-more{font-size:12px}}
</style>
