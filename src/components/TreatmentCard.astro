---
import type { TreatmentInfo } from '../config/clinic.config';

interface Props {
  treatment: TreatmentInfo;
}

const { treatment } = Astro.props;
---

<article class="card treatment-card">
  <div class="treatment-badge">Odontologia em Guaianases</div>
  <h3 class="treatment-title">
    <a href={`/tratamentos/${treatment.slug}`} class="treatment-link">
      {treatment.name}
    </a>
  </h3>
  <p class="treatment-desc">{treatment.shortDescription}</p>
  
  <div class="treatment-highlights">
    <span class="highlight-item">✓ Avaliação individualizada</span>
    <span class="highlight-item">✓ {treatment.responsibleDentist} ({treatment.crosp})</span>
  </div>

  <div class="treatment-actions">
    <a href={`/tratamentos/${treatment.slug}`} class="btn btn-outline card-btn">
      Ver detalhes do tratamento
    </a>
  </div>
</article>

<style>
  .treatment-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .treatment-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .treatment-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .treatment-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .treatment-link {
    color: var(--color-text-main);
    text-decoration: none;
  }

  .treatment-link:hover {
    color: var(--color-primary);
  }

  .treatment-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .treatment-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    background-color: var(--color-bg-body);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
  }

  .treatment-actions {
    margin-top: auto;
  }

  .card-btn {
    width: 100%;
    font-size: 0.92rem;
    padding: 0.75rem;
  }
</style>
