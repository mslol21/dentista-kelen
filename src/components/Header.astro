---
import { clinicConfig } from '../config/clinic.config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Início' },
  { href: '/a-clinica', label: 'A Clínica' },
  { href: '/equipe', label: 'Equipe' },
  { href: '/tratamentos', label: 'Tratamentos' },
  { href: '/conteudos', label: 'Artigos' },
  { href: '/contato', label: 'Contato' },
];
---

<header class="site-header">
  <!-- Top bar informativa -->
  <div class="top-bar">
    <div class="container top-bar-content">
      <div class="top-bar-left">
        <span class="cro-badge">{clinicConfig.cro}</span>
        <span class="location-text">Guaianases, São Paulo - SP</span>
      </div>
      <div class="top-bar-right">
        <a href={`tel:${clinicConfig.contact.phonePrimary}`} class="top-contact-link" aria-label={`Ligar para o telefone ${clinicConfig.contact.phonePrimaryFormatted}`}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>{clinicConfig.contact.phonePrimaryFormatted}</span>
        </a>
        <a href={clinicConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="top-contact-link top-wa" aria-label="Abrir WhatsApp da clínica">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.301-.15-1.776-.876-2.052-.976-.275-.1-.476-.15-.676.15s-.777.976-.952 1.176-.35.226-.651.075c-.301-.15-1.27-.468-2.42-1.493-.894-.798-1.498-1.784-1.674-2.085-.175-.301-.019-.464.132-.614.136-.134.301-.35.452-.525.15-.175.2-.3.301-.501.101-.2.051-.375-.025-.526-.076-.15-.676-1.63-.927-2.233-.244-.588-.492-.508-.676-.517-.175-.009-.375-.011-.576-.011-.201 0-.527.075-.802.375-.276.301-1.053 1.028-1.053 2.507 0 1.479 1.078 2.907 1.228 3.108.15.201 2.122 3.24 5.141 4.543.718.31 1.278.495 1.716.634.721.229 1.377.197 1.896.119.578-.087 1.776-.726 2.026-1.428.251-.702.251-1.303.176-1.428-.075-.125-.276-.2-.577-.35z"/></svg>
          <span>{clinicConfig.contact.whatsappFormatted}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Navegação principal -->
  <nav class="main-nav" aria-label="Navegação principal">
    <div class="container nav-container">
      <a href="/" class="brand-link" aria-label="Página inicial - Dra. Kelen Odontologia">
        <div class="brand-symbol" aria-hidden="true">
<span class="brand-monogram">K.</span>
        </div>
        <div class="brand-text">
          <span class="brand-title">Dra. Kelen</span>
          <span class="brand-sub">ODONTOLOGIA</span>
        </div>
      </a>

      <!-- Menu Desktop -->
      <ul class="nav-menu" role="list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Ação Rápida WhatsApp -->
      <div class="nav-cta">
        <a href={clinicConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp header-wa-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.301-.15-1.776-.876-2.052-.976-.275-.1-.476-.15-.676.15s-.777.976-.952 1.176-.35.226-.651.075c-.301-.15-1.27-.468-2.42-1.493-.894-.798-1.498-1.784-1.674-2.085-.175-.301-.019-.464.132-.614.136-.134.301-.35.452-.525.15-.175.2-.3.301-.501.101-.2.051-.375-.025-.526-.076-.15-.676-1.63-.927-2.233-.244-.588-.492-.508-.676-.517-.175-.009-.375-.011-.576-.011-.201 0-.527.075-.802.375-.276.301-1.053 1.028-1.053 2.507 0 1.479 1.078 2.907 1.228 3.108.15.201 2.122 3.24 5.141 4.543.718.31 1.278.495 1.716.634.721.229 1.377.197 1.896.119.578-.087 1.776-.726 2.026-1.428.251-.702.251-1.303.176-1.428-.075-.125-.276-.2-.577-.35z"/></svg>
          <span>Agendar avaliação <span aria-hidden="true">↗</span></span>
        </a>
      </div>

      <!-- Menu Móvel Botão Nativo -->
      <details class="mobile-menu-details">
        <summary class="mobile-toggle-btn" aria-label="Abrir menu de navegação">
          <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </summary>
        <div class="mobile-dropdown">
          <ul role="list">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={`mobile-nav-link ${currentPath === item.href ? 'active' : ''}`}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="mobile-divider"></li>
            <li>
              <a href={`tel:${clinicConfig.contact.phonePrimary}`} class="mobile-nav-link">
                Ligar: {clinicConfig.contact.phonePrimaryFormatted}
              </a>
            </li>
            <li>
              <a href={clinicConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp mobile-wa-action">
                Falar pelo WhatsApp
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
.brand-monogram{font-family:Georgia,serif;font-size:29px;font-style:italic}.brand-link{flex-shrink:0}.brand-symbol{background:#eef2e7!important;border-radius:50%!important;width:43px!important;height:43px!important}.brand-title{font-family:Georgia,serif;font-size:25px!important;font-weight:400!important;letter-spacing:-.03em}.brand-sub{font-size:9px!important;letter-spacing:.2em;font-weight:500!important}.nav-link{white-space:nowrap;font-size:12px!important}.header-wa-btn{font-size:12px!important;white-space:nowrap;background:#234f3d!important}.nav-container{padding-top:17px!important;padding-bottom:17px!important}.top-bar{padding:5px 0!important;background:#173f34!important;font-size:10px!important}.cro-badge{background:transparent!important;padding-left:0!important}.site-header{box-shadow:0 2px 15px #173f3406}.top-contact-link svg{width:12px}.top-bar-right{gap:20px!important}@media(max-width:600px){.top-wa{display:none!important}.top-bar-content{flex-wrap:nowrap!important}.nav-container{padding-top:13px!important;padding-bottom:13px!important}.brand-title{font-size:23px!important}}@media(min-width:900px) and (max-width:1100px){.nav-menu{gap:10px!important}.header-wa-btn{padding:10px 12px!important}}

  .site-header {
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .top-bar {
    background-color: var(--color-primary-dark);
    color: #e6fffa;
    font-size: 0.85rem;
    padding: 0.4rem 0;
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cro-badge {
    background-color: rgba(255, 255, 255, 0.15);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .location-text {
    color: #ccfbf1;
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .top-contact-link {
    color: #ffffff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
  }

  .top-contact-link:hover {
    text-decoration: underline;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    gap: 1rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-main);
  }

  .brand-symbol {
    width: 44px;
    height: 44px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(17, 94, 89, 0.2);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text-main);
    line-height: 1.2;
  }

  .brand-sub {
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 500;
  }

  .nav-menu {
    display: none;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.4rem 0.25rem;
    position: relative;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link.active {
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  .nav-cta {
    display: none;
  }

  .header-wa-btn {
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
  }

  /* Mobile Dropdown via Details */
  .mobile-menu-details {
    display: block;
    position: relative;
  }

  .mobile-toggle-btn {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    background-color: #ffffff;
    min-width: 44px;
    min-height: 44px;
  }

  .mobile-toggle-btn::-webkit-details-marker {
    display: none;
  }

  .mobile-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: 260px;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.75rem;
    z-index: 200;
  }

  .mobile-dropdown ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.6rem 0.75rem;
    text-decoration: none;
    color: var(--color-text-main);
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background-color: var(--color-primary-light);
    color: var(--color-primary-dark);
  }

  .mobile-divider {
    height: 1px;
    background-color: var(--color-border);
    margin: 0.5rem 0;
  }

  .mobile-wa-action {
    width: 100%;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    padding: 0.65rem;
  }

  @media (min-width: 900px) {
    .nav-menu {
      display: flex;
    }
    .nav-cta {
      display: block;
    }
    .mobile-menu-details {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .top-bar-left .location-text {
      display: none;
    }
  }
</style>
