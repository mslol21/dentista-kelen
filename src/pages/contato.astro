---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { clinicConfig } from '../config/clinic.config';

const breadcrumbs = [
  { name: 'Localização & Contato', url: '/contato' },
];
---

<Layout
  title="Localização & Contato | Dra. Kelen Odontologia Guaianases - SP"
  description="Endereço, telefones e agendamento da Dra. Kelen em Guaianases. Rua Hipólito de Camargo, 65. Telefones (11) 2553-7002 e WhatsApp (11) 98811-9693."
  canonicalPath="/contato"
  breadcrumbs={breadcrumbs}
>
  <div class="container section">
    <div class="page-header">
      <span class="badge">Atendimento & Localização</span>
      <h1>Localização e Canais de Contato</h1>
      <p class="page-lead">
        Fale conosco para tirar dúvidas sobre tratamentos ou solicitar um horário de avaliação em nosso consultório em Guaianases.
      </p>
    </div>

    <div class="contact-layout-grid">
      <!-- Coluna da Esquerda: Formulário Funcional e Acessível -->
      <div class="contact-form-column">
        <ContactForm />
      </div>

      <!-- Coluna da Direita: Informações Físicas, Telefones e Mapa Real -->
      <div class="contact-info-column">
        <div class="card info-box">
          <h2>Canais Diretos de Atendimento</h2>
          
          <div class="contact-direct-list">
            <div class="direct-item">
              <div class="item-icon-wa" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.301-.15-1.776-.876-2.052-.976-.275-.1-.476-.15-.676.15s-.777.976-.952 1.176-.35.226-.651.075c-.301-.15-1.27-.468-2.42-1.493-.894-.798-1.498-1.784-1.674-2.085-.175-.301-.019-.464.132-.614.136-.134.301-.35.452-.525.15-.175.2-.3.301-.501.101-.2.051-.375-.025-.526-.076-.15-.676-1.63-.927-2.233-.244-.588-.492-.508-.676-.517-.175-.009-.375-.011-.576-.011-.201 0-.527.075-.802.375-.276.301-1.053 1.028-1.053 2.507 0 1.479 1.078 2.907 1.228 3.108.15.201 2.122 3.24 5.141 4.543.718.31 1.278.495 1.716.634.721.229 1.377.197 1.896.119.578-.087 1.776-.726 2.026-1.428.251-.702.251-1.303.176-1.428-.075-.125-.276-.2-.577-.35z"/></svg>
              </div>
              <div class="item-text">
                <strong>WhatsApp da Clínica:</strong>
                <a href={clinicConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="item-link">
                  {clinicConfig.contact.whatsappFormatted}
                </a>
                <small>Mensagem rápida para solicitação de avaliação</small>
              </div>
            </div>

            <div class="direct-item">
              <div class="item-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div class="item-text">
                <strong>Telefone Fixo / Recepção:</strong>
                <div class="phone-links">
                  <span>{clinicConfig.contact.phonePrimaryUnit}</span><br />
                  <a href={`tel:${clinicConfig.contact.phonePrimary}`}>{clinicConfig.contact.phonePrimaryFormatted}</a><br />
                  <span>{clinicConfig.contact.phoneSecondaryUnit}</span><br />
                  <a href={`tel:${clinicConfig.contact.phoneSecondary}`}>{clinicConfig.contact.phoneSecondaryFormatted}</a>
                </div>
                <small>Atendimento por ligação em horário comercial</small>
              </div>
            </div>
          </div>

          <hr class="card-divider" />

          <h3>Horários de Atendimento Confirmados</h3>
          <div class="hours-badge-box">
            <p><strong>{clinicConfig.hours.displayWeekdays}</strong></p>
            <p><strong>{clinicConfig.hours.displaySaturday}</strong></p>
            <p style="color: #64748b;">Domingos e feriados: Fechado</p>
          </div>

          <hr class="card-divider" />

          <h3>Endereço Completo</h3>
          <address class="contact-address">
            <p><strong>{clinicConfig.name}</strong></p>
            <p>{clinicConfig.address.street}</p>
            <p>{clinicConfig.address.neighborhood}</p>
            <p>São Paulo - SP • CEP: {clinicConfig.address.postalCode}</p>
          </address>

          <div class="address-actions">
            <a href={clinicConfig.address.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width: 100%;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
              <span>Abrir Rota no Google Maps</span>
            </a>
          </div>
        </div>

        <!-- Mapa Interativo do Google Maps -->
        <div class="card map-photo-card" style="margin-top: 1.5rem; padding: 0; overflow: hidden;">
          <iframe
            src={clinicConfig.address.mapsEmbedUrl}
            width="100%"
            height="360"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localização exata da clínica no Google Maps"
          ></iframe>
          <div class="map-directions-info">
            <h4>Como Chegar ao Consultório</h4>
            <ul class="how-to-arrive-list">
              <li>
                <strong>De Trem / Transporte Público:</strong> A clínica está localizada a poucos minutos da <em>Estação Guaianases (Linha 11-Coral da CPTM)</em> e das principais linhas de ônibus que circulam pelo centro do bairro.
              </li>
              <li>
                <strong>Pontos de Referência:</strong> Próximo à Rua Getulina, Estrada de Poá e Supermercados Semar.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .page-lead {
    font-size: 1.15rem;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .contact-layout-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .info-box {
    background-color: #ffffff;
  }

  .info-box h2 {
    font-size: 1.35rem;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
  }

  .info-box h3 {
    font-size: 1.1rem;
    color: var(--color-text-main);
    margin-bottom: 0.75rem;
  }

  .contact-direct-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .direct-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .item-icon-wa {
    width: 44px;
    height: 44px;
    background-color: var(--color-whatsapp);
    color: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .item-icon {
    width: 44px;
    height: 44px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(13, 148, 136, 0.2);
  }

  .item-text {
    display: flex;
    flex-direction: column;
  }

  .item-link {
    color: var(--color-whatsapp);
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
  }

  .item-link:hover {
    text-decoration: underline;
  }

  .phone-links a {
    color: var(--color-primary);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
  }

  .phone-links a:hover {
    text-decoration: underline;
  }

  .item-text small {
    color: var(--color-text-light);
    font-size: 0.825rem;
    margin-top: 0.2rem;
  }

  .card-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }

  .hours-badge-box {
    background-color: var(--color-primary-light);
    border: 1px solid rgba(13, 148, 136, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
  }

  .hours-badge-box p {
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
  }

  .contact-address {
    font-style: normal;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .contact-address p {
    margin-bottom: 0.2rem;
  }

  .map-real-photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .map-directions-info {
    padding: 1.5rem;
    background-color: #ffffff;
  }

  .map-directions-info h4 {
    color: var(--color-primary-dark);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .how-to-arrive-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.92rem;
  }

  .how-to-arrive-list li {
    line-height: 1.5;
  }
</style>
