---
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { clinicConfig } from '../../config/clinic.config';

const treatment = clinicConfig.treatments.find((t) => t.slug === 'clinica-geral')!;

const breadcrumbs = [
  { name: 'Tratamentos', url: '/tratamentos' },
  { name: treatment.name, url: `/tratamentos/${treatment.slug}` },
];
---

<Layout
  title={`${treatment.name} em Guaianases - SP | Dra. Kelen Odontologia`}
  description="Atendimento em Clínica Geral Odontológica em Guaianases com a Dra. Kelen (CROSP 118603). Profilaxia, restaurações em resina e prevenção bucal."
  canonicalPath={`/tratamentos/${treatment.slug}`}
  breadcrumbs={breadcrumbs}
>
  <article class="container section">
    <div class="treatment-header">
      <span class="badge">Saúde Bucal Integral & Prevenção</span>
      <h1>{treatment.name} em Guaianases</h1>
      <p class="treatment-lead">{treatment.heroHeadline}</p>
      
      <div class="treatment-meta-bar">
        <span><strong>Responsável Técnica:</strong> {treatment.responsibleDentist} ({treatment.crosp})</span>
        <span>•</span>
        <span><strong>Local:</strong> Guaianases - São Paulo/SP</span>
      </div>
    </div>

    <div class="treatment-content-grid">
      <div class="main-body">
        <!-- O que é -->
        <section class="content-block">
          <h2>O que é a Clínica Geral Odontológica?</h2>
          <p>{treatment.whatIsIt}</p>
        </section>

        <!-- Quando considerar -->
        <section class="content-block">
          <h2>Em quais situações agendar uma avaliação?</h2>
          <ul class="check-list">
            {treatment.whenToConsider.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Como acontece a avaliação -->
        <section class="content-block">
          <h2>Como acontece a avaliação clínica?</h2>
          <ol class="num-list">
            {treatment.evaluationProcess.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>

        <!-- Etapas gerais e cuidados -->
        <section class="content-block">
          <h2>Etapas do Atendimento e Cuidados Práticos</h2>
          <div class="stages-container">
            {treatment.stagesAndCare.map((stage) => (
              <div class="stage-card">
                <h3>{stage.title}</h3>
                <p>{stage.text}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Limitações e Ética -->
        <section class="content-block ethics-alert">
          <h3>Transparência e Limitações do Tratamento</h3>
          <p>{treatment.limitationsAndEthics}</p>
        </section>

        <!-- Dúvidas Frequentes -->
        <section class="content-block">
          <FaqAccordion faqs={treatment.faqs} sectionTitle="Dúvidas Frequentes sobre Clínica Geral" />
        </section>
      </div>

      <!-- Barra Lateral de Conversão -->
      <aside class="sidebar">
        <div class="card booking-sidebar-card">
          <h3>Solicitar Avaliação</h3>
          <p>Deseja checar a saúde dos seus dentes ou tratar algum desconforto?</p>
          
          <div class="sidebar-contact-info">
            <p><strong>Clínica Dra. Kelen</strong></p>
            <p>{clinicConfig.address.street} - Guaianases</p>
            <p>Tel: {clinicConfig.contact.phonePrimaryFormatted}</p>
          </div>

          <a href={clinicConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" style="width: 100%;">
            Falar no WhatsApp
          </a>

          <a href={`tel:${clinicConfig.contact.phonePrimary}`} class="btn btn-secondary" style="width: 100%; margin-top: 0.75rem;">
            Ligar para o Consultório
          </a>

          <small class="sidebar-privacy-note">
            A mensagem inicial no WhatsApp é apenas uma intenção de agendamento. O atendimento presencial e os horários são confirmados diretamente com a nossa recepcionista.
          </small>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
          <h4>Outros Tratamentos</h4>
          <ul class="other-treatments-list">
            {clinicConfig.treatments.filter((t) => t.slug !== treatment.slug).map((ot) => (
              <li>
                <a href={`/tratamentos/${ot.slug}`}>{ot.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .treatment-header {
    max-width: 840px;
    margin-bottom: 3rem;
  }

  .treatment-lead {
    font-size: 1.25rem;
    color: var(--color-primary-dark);
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .treatment-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-top: 1rem;
    background-color: var(--color-bg-body);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .treatment-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .treatment-content-grid {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }

  .content-block {
    margin-bottom: 2.75rem;
  }

  .content-block h2 {
    color: var(--color-primary-dark);
    font-size: 1.45rem;
    margin-bottom: 1rem;
  }

  .check-list, .num-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-left: 1.25rem;
  }

  .check-list li, .num-list li {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .stages-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stage-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
  }

  .stage-card h3 {
    font-size: 1.1rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.35rem;
  }

  .stage-card p {
    margin: 0;
    font-size: 0.95rem;
  }

  .ethics-alert {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .ethics-alert h3 {
    color: #92400e;
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .ethics-alert p {
    color: #78350f;
    margin: 0;
    font-size: 0.95rem;
  }

  .booking-sidebar-card {
    background-color: var(--color-primary-light);
    border-color: rgba(13, 148, 136, 0.3);
  }

  .booking-sidebar-card h3 {
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .sidebar-contact-info {
    margin: 1.25rem 0;
    padding: 0.75rem;
    background-color: #ffffff;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    border: 1px solid rgba(13, 148, 136, 0.2);
  }

  .sidebar-contact-info p {
    margin-bottom: 0.25rem;
  }

  .sidebar-privacy-note {
    display: block;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-light);
    line-height: 1.4;
  }

  .other-treatments-list {
    list-style: none;
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .other-treatments-list a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
  }

  .other-treatments-list a:hover {
    text-decoration: underline;
  }
</style>
