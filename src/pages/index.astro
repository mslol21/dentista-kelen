---
import Layout from "../layouts/Layout.astro";
import TreatmentCard from "../components/TreatmentCard.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { clinicConfig } from "../config/clinic.config";

const homeFaqs = [
  {
    question: "Como faço para agendar minha avaliação odontológica?",
    answer:
      "Você pode solicitar atendimento diretamente pelo nosso WhatsApp (11 98811-9693) ou ligando para (11) 2553-7002. Nossa equipe responderá em horário comercial para encontrar o melhor horário para você.",
  },
  {
    question: "Qual é o endereço da clínica em Guaianases?",
    answer:
      "Estamos localizados na Rua Hipólito de Camargo, 65 - Vila Minerva / Guaianases, São Paulo - SP, CEP 08410-030. Ficamos a poucos metros do comércio central de Guaianases, próximos ao Supermercado Semar e com fácil acesso a partir da estação de trem da CPTM.",
  },
  {
    question: "Quais tratamentos são realizados no consultório?",
    answer:
      "Oferecemos Clínica Geral (limpezas, profilaxias, restaurações e alívio de dor), Ortodontia (aparelhos fixos e alinhamento dental), Odontologia Estética (clareamento dental e restaurações estéticas) e Cirurgia Odontológica (extrações dentárias e procedimentos cirúrgicos bucais ambulatoriais).",
  },
  {
    question: "A clínica aceita convênios odontológicos?",
    answer:
      "Entre em contato com a nossa equipe para confirmar os convênios e as condições de atendimento disponíveis.",
  },
  {
    question: "Como funciona a primeira consulta?",
    answer:
      "Na primeira visita, a Dra. Kelen realiza uma conversa para entender suas necessidades e histórico de saúde, seguida de exame clínico minucioso da cavidade bucal. Apresentamos um plano transparente com as prioridades de tratamento, sem procedimentos desnecessários.",
  },
];
---

<Layout
  title="Dra. Kelen | Dentista em Guaianases, São Paulo"
  description="Cuide do seu sorriso com a Dra. Kelen em Guaianases. Clínica geral, ortodontia, estética e cirurgia odontológica. Solicite seu agendamento pelo WhatsApp."
  canonicalPath="/"
>
  <section class="dental-hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"
          ><span class="status-dot"></span> ODONTOLOGIA EM GUAIANASES</span
        >
        <h1 id="hero-heading">
          Seu sorriso merece um <em>cuidado especial.</em>
        </h1>
        <p>
          Saúde, confiança e acolhimento em cada consulta. Conheça o atendimento
          da Dra. Kelen e dê o próximo passo para cuidar de você.
        </p>
        <div class="hero-actions">
          <a
            class="btn btn-primary"
            href={clinicConfig.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            >Agendar minha avaliação <span aria-hidden="true">↗</span></a
          >
          <a class="text-link" href="/tratamentos"
            >Conhecer os tratamentos <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="hero-signature">
          <span class="signature-mark" aria-hidden="true">K.</span><div>
            <strong>Dra. Kelen Carla Fernandez Rocha</strong><span
              >Cirurgiã-dentista · {clinicConfig.cro}</span>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="portrait-frame">
          <img
            src="/images/dentista-atendimento.jpg"
            alt="Imagem ilustrativa de uma profissional em ambiente odontológico"
            width="1200"
            height="896"
            fetchpriority="high"
            loading="eager"
          />
        </div>
        <div class="floating-note">
          <span class="note-icon" aria-hidden="true">✦</span><div>
            <strong>O cuidado começa com a escuta.</strong><span
              >Uma avaliação para cada história.</span>
          </div>
        </div>
        <span class="image-disclosure">Imagem ilustrativa</span>
        <span class="visual-word" aria-hidden="true">sorria.</span>
      </div>
    </div>
  </section>
  <div class="care-strip">
    <div class="container care-strip-grid">
      <div>
        <span aria-hidden="true">01</span><p>
          <strong>Perto de você</strong>Guaianases · Zona Leste
        </p>
      </div><div>
        <span aria-hidden="true">02</span><p>
          <strong>Cuidado individualizado</strong>Avaliação e orientação
        </p>
      </div><div>
        <span aria-hidden="true">03</span><p>
          <strong>Agendamento simples</strong>Converse pelo WhatsApp
        </p>
      </div>
    </div>
  </div>

  <section
    class="section treatments-section"
    id="tratamentos"
    aria-labelledby="treatments-heading"
  >
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="eyebrow">SAÚDE E HARMONIA</span><h2
            id="treatments-heading"
          >
            Cuidado completo.<br /><em>Um sorriso de cada vez.</em>
          </h2>
        </div><p>
          Da prevenção ao planejamento do seu tratamento, encontre orientação
          para cuidar da sua saúde bucal em todas as fases.
        </p>
      </div><div class="grid-cards">
        {
          clinicConfig.treatments.map((treatment) => (
            <TreatmentCard treatment={treatment} />
          ))
        }
      </div><div class="section-bottom-link">
        <span>Não sabe por onde começar?</span><a
          class="text-link"
          href={clinicConfig.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          >Fale com a nossa equipe <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section
    class="experience-section section"
    aria-labelledby="experience-heading"
  >
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="eyebrow">SIMPLES, DO PRIMEIRO CONTATO À CONSULTA</span
          ><h2 id="experience-heading">
            Mais tranquilidade.<br /><em>Desde o primeiro encontro.</em>
          </h2>
        </div><p>
          Você merece entender cada etapa. O atendimento começa com uma conversa
          e segue com um planejamento pensado para você.
        </p>
      </div><div class="experience-grid">
        {
          [
            {
              number: "01",
              title: "Vamos conversar",
              text: "Conte o que você procura. Nossa equipe ajuda a encontrar um horário para a sua avaliação.",
            },
            {
              number: "02",
              title: "Olhar para você",
              text: "Na consulta, ouvimos suas necessidades e avaliamos a saúde dos dentes e das gengivas.",
            },
            {
              number: "03",
              title: "Decidir com clareza",
              text: "Você conhece as possibilidades, tira suas dúvidas e participa das decisões sobre o tratamento.",
            },
          ].map((step) => (
            <div class="experience-step">
              <>
                <span class="step-index">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section welcome-section" aria-labelledby="welcome-heading">
    <div class="container welcome-grid">
      <div class="welcome-art">
        <img
          src="/images/hero-recepcao-clinica.jpg"
          alt="Ilustração de recepção odontológica, com ambiente claro e acolhedor"
          width="1024"
          height="571"
          loading="lazy"
        /><span>Imagem ilustrativa de ambiente odontológico</span>
      </div><div class="welcome-copy">
        <span class="eyebrow">DRA. KELEN · GUAIANASES</span><h2
          id="welcome-heading"
        >
          Técnica e cuidado.<br /><em>Com espaço para ouvir.</em>
        </h2><p>
          Um atendimento próximo começa com respeito à sua história. A Dra.
          Kelen Carla Fernandez Rocha recebe você para uma avaliação e explica
          as possibilidades de tratamento em linguagem clara.
        </p><div class="welcome-detail">
          <strong>{clinicConfig.cro}</strong><span
            >Cirurgiã-dentista<br />Rua Hipólito de Camargo, 65</span>
        </div><a class="text-link" href="/equipe"
          >Conheça a Dra. Kelen <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section
    class="section location-section"
    id="localizacao"
    aria-labelledby="location-heading"
  >
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="eyebrow">SEU PRÓXIMO PASSO ESTÁ PERTO</span><h2
            id="location-heading"
          >
            Nos encontramos<br /><em>em Guaianases.</em>
          </h2>
        </div><p>
          Consulte os horários e converse com a equipe para planejar sua visita.
        </p>
      </div><div class="location-panel">
        <div class="location-copy">
          <h3>Como chegar</h3><address>
            {clinicConfig.address.street}<br />Vila Minerva · Guaianases<br
            />São Paulo – SP · {clinicConfig.address.postalCode}
          </address><div class="hours-list">
            <span>Segunda a sexta<strong>09h às 19h</strong></span><span
              >Sábado<strong>09h às 16h</strong></span>
          </div><a
            class="btn btn-primary"
            href={clinicConfig.address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            >Ver no Google Maps <span aria-hidden="true">↗</span></a
          ><a
            class="location-phone"
            href={`tel:${clinicConfig.contact.phonePrimary}`}
            >{clinicConfig.contact.phonePrimaryFormatted}</a>
        </div><iframe
          src={clinicConfig.address.mapsEmbedUrl}
          title="Localização do consultório da Dra. Kelen em Guaianases"
          width="700"
          height="420"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen=""></iframe>
      </div>
    </div>
  </section>

  <section class="section faq-home" aria-labelledby="questions-heading">
    <div class="container faq-grid">
      <div>
        <span class="eyebrow">ANTES DA SUA VISITA</span><h2
          id="questions-heading"
        >
          Sua dúvida<br /><em>merece atenção.</em>
        </h2><p>
          Informações para você dar o primeiro passo com mais tranquilidade.
        </p><a
          class="text-link"
          href={clinicConfig.contact.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          >Tenho outra dúvida <span aria-hidden="true">↗</span></a>
      </div><FaqAccordion faqs={homeFaqs} sectionTitle="" />
    </div>
  </section>

  <section class="closing-section">
    <div class="container closing-inner">
      <div>
        <span class="eyebrow">VAMOS CUIDAR DO SEU SORRISO?</span><h2>
          O primeiro passo<br />é uma <em>boa conversa.</em>
        </h2><p>Solicite sua avaliação e consulte os horários disponíveis.</p>
      </div><a
        class="btn btn-primary"
        href={clinicConfig.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        >Conversar pelo WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
<style>
  .dental-hero {
    background: #f5f3ec;
    overflow: hidden;
    padding: 70px 0 62px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    gap: 70px;
    align-items: center;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 22px;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #648a69;
  }
  .hero-copy h1 {
    font-size: clamp(44px, 5.3vw, 76px);
    font-family: var(--font-display);
    line-height: 1.06;
    font-weight: 400;
    letter-spacing: -0.055em;
    color: #183e36;
    margin: 0 0 26px;
    max-width: 650px;
  }
  .hero-copy h1 em {
    font-weight: 400;
    color: #59836b;
  }
  .hero-copy > p {
    font-size: 17px;
    line-height: 1.8;
    max-width: 460px;
    color: #53645b;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin: 32px 0 38px;
  }
  .hero-signature {
    border-top: 1px solid #d9ded2;
    padding-top: 24px;
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .signature-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid #c5d3c6;
    border-radius: 50%;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
    color: #315e48;
  }
  .hero-signature strong {
    font-size: 13px;
    display: block;
    color: #294c3b;
  }
  .hero-signature div > span {
    display: block;
    font-size: 12px;
    color: #657164;
    margin-top: 3px;
  }
  .hero-visual {
    position: relative;
    padding-bottom: 25px;
  }
  .portrait-frame {
    height: 535px;
    border-radius: 220px 220px 18px 18px;
    overflow: hidden;
    background: #dfe5d8;
  }
  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    display: block;
  }
  .floating-note {
    position: absolute;
    left: -28px;
    bottom: 48px;
    background: #fffdf7;
    border-radius: 12px;
    padding: 18px 22px;
    display: flex;
    gap: 14px;
    align-items: center;
    box-shadow: 0 14px 40px #183e361a;
    max-width: calc(100% + 10px);
  }
  .note-icon {
    font-size: 30px;
    color: #6f8a58;
  }
  .floating-note strong {
    display: block;
    font-size: 13px;
    color: #284d3a;
  }
  .floating-note div > span {
    font-size: 11px;
    color: #6b7569;
    display: block;
    margin-top: 4px;
  }
  .image-disclosure {
    position: absolute;
    bottom: 5px;
    right: 0;
    font-size: 10px;
    color: #657164;
  }
  .visual-word {
    position: absolute;
    right: -17px;
    top: -24px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 36px;
    transform: rotate(8deg);
    color: #315b42;
  }
  .care-strip {
    background: #e9ede2;
    border-top: 1px solid #dae1d3;
    border-bottom: 1px solid #dae1d3;
    padding: 26px 0;
  }
  .care-strip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }
  .care-strip-grid > div {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .care-strip-grid > div > span {
    font-family: var(--font-display);
    font-size: 26px;
    color: #5f8058;
  }
  .care-strip p {
    margin: 0;
    font-size: 12px;
    color: #66745e;
  }
  .care-strip strong {
    display: block;
    font-size: 14px;
    color: #2c4937;
    margin-bottom: 3px;
  }
  .section-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 50px;
    margin-bottom: 40px;
  }
  .section-heading-row h2,
  .welcome-copy h2,
  .faq-home h2 {
    font-size: clamp(34px, 3.8vw, 50px);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .section-heading-row h2 em,
  .welcome-copy h2 em,
  .faq-home h2 em {
    font-weight: 400;
    color: #66846a;
  }
  .section-heading-row > p {
    max-width: 340px;
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
    color: #647066;
  }
  .section-bottom-link {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 13px;
  }
  .section-bottom-link > span {
    color: #6d776b;
  }
  .experience-section {
    background: #173f34;
    color: white;
  }
  .experience-section .eyebrow {
    color: #cad9b5;
  }
  .experience-section h2 {
    color: #fff;
  }
  .experience-section h2 em {
    color: #c3d5a5;
  }
  .experience-section .section-heading-row > p {
    color: #c3d2c6;
  }
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
    margin-top: 54px;
  }
  .experience-step {
    border-top: 1px solid #668473;
    padding-top: 20px;
  }
  .step-index {
    font-family: var(--font-display);
    font-size: 28px;
    color: #b8cc9e;
  }
  .experience-step h3 {
    color: #fff;
    font-size: 21px;
    font-weight: 500;
    margin: 22px 0 12px;
  }
  .experience-step p {
    color: #c7d6cb;
    font-size: 14px;
    line-height: 1.8;
    max-width: 300px;
  }
  .welcome-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: center;
  }
  .welcome-art {
    position: relative;
  }
  .welcome-art img {
    width: 100%;
    height: 400px;
    display: block;
    object-fit: cover;
    border-radius: 18px 120px 18px 18px;
  }
  .welcome-art > span {
    font-size: 10px;
    color: #687468;
    display: block;
    margin-top: 9px;
  }
  .welcome-copy > p {
    font-size: 15px;
    line-height: 1.85;
    margin: 24px 0;
    color: #626e63;
  }
  .welcome-detail {
    display: flex;
    gap: 24px;
    border-top: 1px solid #dce1d5;
    border-bottom: 1px solid #dce1d5;
    padding: 20px 0;
    margin-bottom: 25px;
    font-size: 12px;
    align-items: center;
  }
  .welcome-detail strong {
    color: #305943;
  }
  .welcome-detail span {
    color: #687466;
  }
  .location-section {
    background: #edf0e6;
  }
  .location-panel {
    display: grid;
    grid-template-columns: 0.75fr 1.3fr;
    overflow: hidden;
    border: 1px solid #d7dfd0;
    border-radius: 18px;
    background: white;
  }
  .location-copy {
    padding: 36px;
  }
  .location-copy h3 {
    font-size: 24px;
    font-family: var(--font-display);
    font-weight: 400;
    color: #264936;
  }
  .location-copy address {
    font-style: normal;
    font-size: 14px;
    color: #657164;
    line-height: 1.85;
    margin: 18px 0 24px;
  }
  .hours-list {
    border-top: 1px solid #e1e5dc;
    padding-top: 20px;
    margin-bottom: 24px;
  }
  .hours-list > span {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 12px;
    color: #687468;
    margin-bottom: 10px;
  }
  .hours-list strong {
    font-weight: 500;
    color: #304c37;
  }
  .location-panel iframe {
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
  }
  .location-phone {
    display: block;
    margin-top: 17px;
    font-size: 13px;
    color: #335b42;
    text-decoration: none;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 90px;
  }
  .faq-grid > div > p {
    font-size: 14px;
    line-height: 1.8;
    max-width: 300px;
    margin: 23px 0;
  }
  .closing-section {
    background: #dbe4c8;
    padding: 68px 0;
  }
  .closing-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
  }
  .closing-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.8vw, 62px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: #234b35;
  }
  .closing-inner h2 em {
    font-weight: 400;
  }
  .closing-inner p {
    font-size: 14px;
    color: #506650;
    margin: 20px 0 0;
  }
  .closing-inner .btn {
    flex-shrink: 0;
  }
  .treatments-section {
    background: #fffdf8;
  }
  .welcome-section,
  .faq-home {
    background: #f9f8f2;
  }
  @media (max-width: 1050px) {
    .hero-grid {
      gap: 40px;
    }
    .portrait-frame {
      height: 480px;
    }
    .hero-copy h1 {
      font-size: 58px;
    }
    .hero-actions {
      gap: 18px;
    }
    .welcome-grid,
    .faq-grid {
      gap: 45px;
    }
    .location-copy {
      padding: 26px;
    }
  }
  @media (max-width: 767px) {
    .dental-hero {
      padding: 38px 0 34px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }
    .hero-copy h1 {
      font-size: clamp(43px, 10.5vw, 65px);
      max-width: 600px;
    }
    .hero-copy > p {
      font-size: 15px;
      max-width: 100%;
    }
    .hero-actions {
      margin: 25px 0 28px;
      gap: 20px;
    }
    .hero-signature {
      padding-top: 18px;
    }
    .hero-visual {
      max-width: 480px;
      width: 100%;
      margin: 0 auto;
    }
    .portrait-frame {
      height: 380px;
      border-radius: 180px 180px 16px 16px;
    }
    .floating-note {
      left: 12px;
      bottom: 43px;
      padding: 15px 17px;
      max-width: calc(100% - 24px);
    }
    .visual-word {
      right: 8px;
      top: -23px;
      font-size: 28px;
    }
    .care-strip-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }
    .care-strip-grid > div {
      gap: 17px;
    }
    .care-strip-grid > div + div {
